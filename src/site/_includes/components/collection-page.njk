<section class="collection-page" aria-labelledby="collection-title">
  <header class="collection-header">
    <h1 id="collection-title">{{ 'COLLECTION_TITLE' | i18n({}, locale) }}</h1>
    <nav class="collection-tabs" aria-label="{{ 'COLLECTION_TITLE' | i18n({}, locale) }}">
      <a
        {% if collectionType == "movies" %}aria-current="page"{% endif %}
        href="/collection/movies/"
        >{{ 'COLLECTION_MOVIES' | i18n({}, locale) }}</a
      >
      <a {% if collectionType == "books" %}aria-current="page"{% endif %} href="/collection/books/"
        >{{ 'COLLECTION_BOOKS' | i18n({}, locale) }}</a
      >
    </nav>
  </header>

  {% if collectionType == "movies" %}
    {% for group in movies | groupMoviesByWatchedYear %}
      {% if group.year %}
        {% set groupHeadingId = "collection-year-" + group.year %}
      {% else %}
        {% set groupHeadingId = "collection-year-undated" %}
      {% endif %}
      <section class="collection-year-group" aria-labelledby="{{ groupHeadingId }}">
        <h2 id="{{ groupHeadingId }}" class="collection-year">
          {% if group.year %}{{ group.year }}{% else %}{{ 'COLLECTION_NO_WATCHED_YEAR' | i18n({}, locale) }}{% endif %}
        </h2>
        <div class="movie-grid">
          {% for movie in group.movies %}
            <article class="movie-card">
              <div class="movie-poster">
                <img
                  src="{{ movie.poster }}"
                  alt="{{ movie.title }}"
                  width="380"
                  height="562"
                  loading="lazy"
                />
                {% if movie.rating %}
                  <span class="movie-rating" aria-label="Rating {{ movie.rating }} out of 10"
                    ><span class="rating-star" aria-hidden="true">★</span> {{ movie.rating }} /
                    10</span
                  >
                {% endif %}
              </div>
              <div class="movie-card-heading">
                <div class="movie-title">
                  <h3>{{ movie.title }}</h3>
                  <a
                    class="movie-imdb-link"
                    href="https://www.imdb.com/title/{{ movie.id }}/"
                    target="_blank"
                    rel="noreferrer"
                    aria-label="Open {{ movie.title }} on IMDb"
                    >↗</a
                  >
                </div>
                <time datetime="{{ movie.year }}">{{ movie.year }}</time>
              </div>
              {% if movie.description %}<p>{{ movie.description }}</p>{% endif %}
              {% if movie.watchedDate %}
                <p class="collection-date">
                  <time datetime="{{ movie.watchedDate }}">{{ movie.watchedDisplay }}</time>
                </p>
              {% endif %}
            </article>
          {% endfor %}
        </div>
      </section>
    {% endfor %}
  {% elif collectionType == "books" %}
    <section class="collection-year-group" aria-labelledby="collection-year-2020">
      <h2 id="collection-year-2020" class="collection-year">2020</h2>
      <div class="movie-grid">
        <article class="movie-card">
          <div class="movie-poster">
            <span class="movie-rating" aria-label="Rating 9.0 out of 10"
              ><span class="rating-star" aria-hidden="true">★</span> 9.0 / 10</span
            >
          </div>
          <div class="movie-card-heading">
            <h3>Stoner</h3>
            <time datetime="1965">1965</time>
          </div>
          <p>{{ 'COLLECTION_BOOK_ONE_TEXT' | i18n({}, locale) }}</p>
          <p class="collection-date"><time datetime="2020-04-16">16.04</time></p>
        </article>

        <article class="movie-card">
          <div class="movie-poster">
            <span class="movie-rating" aria-label="Rating 8.7 out of 10"
              ><span class="rating-star" aria-hidden="true">★</span> 8.7 / 10</span
            >
          </div>
          <div class="movie-card-heading">
            <h3>Pachinko</h3>
            <time datetime="2017">2017</time>
          </div>
          <p>{{ 'COLLECTION_BOOK_TWO_TEXT' | i18n({}, locale) }}</p>
          <p class="collection-date"><time datetime="2020-09-07">07.09</time></p>
        </article>
      </div>
    </section>
  {% else %}
    <article class="collection-placeholder">
      <div class="collection-placeholder-copy">
        <p>{{ placeholderText | i18n({}, locale) }}</p>
        <span>{{ collectionLabel | i18n({}, locale) }}</span>
      </div>
      <img src="{{ imageUrl }}" alt="" width="1672" height="941" />
    </article>
  {% endif %}
</section>
