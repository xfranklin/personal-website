<meta charset="UTF-8" />

<title>{{ title }}{% if title %}·{% endif %}Даниил Феленюк</title>
<meta name="description" content="{{ description }}" />

<meta property="og:type" content="website" />
<meta property="og:title" content="{{ title }}{% if title %}·{% endif %}Даниил Феленюк" />
<meta property="og:description" content="{{ description }}" />

<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="color-scheme" content="light dark" />
<meta name="robots" content="{{ robots | default('index,follow') }}" />
{% if translationKey %}
  {% for item in collections.all %}
    {% if item.data.translationKey == translationKey %}
      <link rel="alternate" hreflang="{{ item.data.locale }}" href="{{ site.url }}{{ item.url }}" />
      {% if item.data.locale == "uk" %}
        <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ item.url }}" />
      {% endif %}
    {% endif %}
  {% endfor %}
{% endif %}
<link rel="icon" type="image/svg+xml" href="/assets/images/fav.svg" />
<script>
  (() => {
    try {
      const savedTheme = localStorage.getItem("theme");
      const theme =
        savedTheme || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      document.documentElement.dataset.theme = theme;
    } catch {
      document.documentElement.dataset.theme = "light";
    }
  })();
</script>
<link rel="stylesheet" href="/assets/css/index.css?v={{ assetVersion }}" />
<script src="/assets/js/theme-toggle.js" defer></script>
