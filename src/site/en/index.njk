---
layout: layouts/base
title: Daniil Feleniuk
description: ""
locale: en
translationKey: home
---

<section class="publication-page" aria-labelledby="home-title">
  <header class="publication-header">
    <h1 id="home-title">{{ 'HOME_TITLE' | i18n({}, locale) }}</h1>
  </header>

  <div class="publication-list">
    {% for post in collections.newPublications | sortArticles %}
      <article class="publication-entry">
        <div>
          <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
        </div>
        <time datetime="{{ post.date | dateToIsoString }}">{{ post.date | formatDate }}</time>
      </article>
    {% else %}
      <p class="publication-empty">{{ 'HOME_EMPTY' | i18n({}, locale) }}</p>
    {% endfor %}
  </div>
</section>
